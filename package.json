{
  "name": "community-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Community Lab IDE: an independent desktop IDE for actuarial agent-based simulation. A South African province where every person is an agent, published mortality and fertility bases, double-entry books, a burial society, paired experiments on a local worker pool, and a workbench of scenario, experiment and script files. Bun + React + ECharts + three.js; a local Ollama model by default.",
  "license": "LicenseRef-Scelo-IDE-1.1",
  "homepage": "https://intelligentactuaries.com/community-lab",
  "bugs": {
    "url": "https://github.com/intelligentactuaries/community-lab/issues",
    "email": "bugs@scelo.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intelligentactuaries/community-lab.git"
  },
  "author": {
    "name": "Intelligent Actuaries",
    "email": "hello@intelligentactuaries.com"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "COMMUNITY_STATIC_DIR=dist bun src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "batch": "bun scripts/batch.ts",
    "calibrate": "bun scripts/calibrate.ts",
    "desktop:install": "cd desktop && bun install",
    "desktop:dev": "cd desktop && bun run dev",
    "desktop:dist:linux": "cd desktop && bun run dist:linux",
    "desktop:dist:win": "cd desktop && bun run dist:win",
    "desktop:dist:mac": "cd desktop && bun run dist:mac"
  },
  "dependencies": {
    "@fontsource/sn-pro": "^5.2.6",
    "echarts": "^5.5.1",
    "monaco-editor": "0.55.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^25.9.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
