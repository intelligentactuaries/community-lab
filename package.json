{
  "name": "@ia/community-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Community Lab — an actuarial agent-based life-course microsimulation of a 12-household Christian community, animated in 2D. Bun + React + ECharts, Ollama gpt-oss by default.",
  "license": "LicenseRef-Scelo-IDE-1.1",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "COMMUNITY_STATIC_DIR=dist bun src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "test:exchange": "bun test tests/exchange.test.ts",
    "batch": "bun scripts/batch.ts",
    "calibrate": "bun scripts/calibrate.ts"
  },
  "dependencies": {
    "@fontsource/sn-pro": "^5.2.6",
    "@scelo/core": "workspace:*",
    "echarts": "^5.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^25.9.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
